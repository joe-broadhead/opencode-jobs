{
  "name": "@joe-broadhead/opencode-jobs",
  "version": "0.0.3",
  "private": true,
  "description": "Unofficial OpenCode plugin that runs agent prompts, slash commands, reminders and no-model scripts on cron, interval and one-off schedules, inside OpenCode, with run history and unattended permissions",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "jobs"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-jobs.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-jobs#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-jobs/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "skills",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "NOTICE",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.4.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ]
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check.mjs forbidden",
    "conformance": "bun scripts/conformance.ts",
    "drift": "bun scripts/drift.mjs",
    "capture": "node scripts/capture-tools.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/source-contract": "github:we-the-rebel-alliance/source-contract#v0.3.0",
    "babel-preset-solid": "1.9.16",
    "croner": "11.0.0",
    "esbuild": "0.28.2",
    "quickjs-wasi": "3.6.2",
    "solid-js": "1.9.17",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "sources": {
    "contractVersion": 1,
    "rpc": "jobs.scheduler.tools",
    "probe": {
      "action": "jobs_probe"
    },
    "items": [
      {
        "id": "jobs.runs",
        "kind": "events",
        "reads": "x-jobs/run",
        "tool": "events_list",
        "input": {
          "source": "runs"
        },
        "accounts": {
          "named": false
        },
        "permission": {
          "events": "jobs_events_list",
          "operations": [
            "history"
          ]
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 65536
      },
      {
        "id": "jobs.runs.list",
        "kind": "snapshot",
        "tool": "jobs_history",
        "input": {
          "source": "runs",
          "list": "runs"
        },
        "output": "list",
        "accounts": {
          "named": false
        },
        "permission": {
          "tool": "jobs_history",
          "rules": [
            {
              "action": "jobs_history",
              "resource": "*"
            }
          ]
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxAgeSec": 900,
        "maxBytes": 65536
      }
    ]
  },
  "jelly": {
    "title": "Jobs",
    "summary": "Run prompts, slash commands, reminders and no-model scripts on a schedule, inside OpenCode.",
    "icon": "assets/icon.svg",
    "cost": "Jobs has no provider bill. A reminder is posted with no model turn, a script calls plugin tools and no model, and the source reads only this machine. A prompt uses the agent's model.",
    "tools": [
      {
        "name": "jobs.status",
        "permission": "jobs_status",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "jobs.list",
        "permission": "jobs_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "jobs.get",
        "permission": "jobs_get",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "jobs.history",
        "permission": "jobs_history",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "jobs.pause",
        "permission": "jobs_pause",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "jobs.pause_all",
        "permission": "jobs_pause_all",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "jobs.create",
        "permission": "jobs_create",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "jobs.update",
        "permission": "jobs_update",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "jobs.delete",
        "permission": "jobs_delete",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "jobs.run_now",
        "permission": "jobs_run_now",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "jobs.resume",
        "permission": "jobs_resume",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "jobs.extend",
        "permission": "jobs_extend",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "jobs.approve",
        "permission": "jobs_approve",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "jobs.run_script",
        "permission": "jobs_run_script",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "jobs"
    ],
    "rpc": [],
    "views": [],
    "signIns": [],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "default": "all",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "description": "What Jobs' tools and scripts may do without asking. Generates default rules for agents with a base allow rule."
        }
      ]
    }
  }
}
